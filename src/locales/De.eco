namespace calendar;

internal function germanLocale() : Locale
{
    array<string> $months = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
    array<string> $monthsShort = ['Jan.', 'Feb.', 'März', 'Apr.', 'Mai', 'Juni', 'Juli', 'Aug.', 'Sept.', 'Okt.', 'Nov.', 'Dez.'];
    array<string> $monthsStandaloneShort = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
    array<string> $monthsNarrow = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
    array<string> $weekdays = ['Montag', 'Dienstag', 'Mittwoch', 'Donnerstag', 'Freitag', 'Samstag', 'Sonntag'];
    array<string> $weekdaysShort = ['Mo.', 'Di.', 'Mi.', 'Do.', 'Fr.', 'Sa.', 'So.'];
    array<string> $weekdaysNarrow = ['M', 'D', 'M', 'D', 'F', 'S', 'S'];
    array<string> $quarters = ['1. Quartal', '2. Quartal', '3. Quartal', '4. Quartal'];
    array<string> $quartersShort = ['Q1', 'Q2', 'Q3', 'Q4'];
    array<string> $eras = ['v. Chr.', 'n. Chr.'];
    array<string> $erasWide = ['v. Chr.', 'n. Chr.'];
    array<string> $dayPeriods = ['AM', 'PM'];
    array<string> $units = ['Jahr', 'Jahre', 'Monat', 'Monate', 'Woche', 'Wochen', 'Tag', 'Tage', 'Stunde', 'Stunden', 'Minute', 'Minuten', 'Sekunde', 'Sekunden'];
    array<string> $relative = [
        'in # Jahr', 'in # Jahren', 'vor # Jahr', 'vor # Jahren',
        'in # Monat', 'in # Monaten', 'vor # Monat', 'vor # Monaten',
        'in # Woche', 'in # Wochen', 'vor # Woche', 'vor # Wochen',
        'in # Tag', 'in # Tagen', 'vor # Tag', 'vor # Tagen',
        'in # Stunde', 'in # Stunden', 'vor # Stunde', 'vor # Stunden',
        'in # Minute', 'in # Minuten', 'vor # Minute', 'vor # Minuten',
        'in # Sekunde', 'in # Sekunden', 'vor # Sekunde', 'vor # Sekunden',
    ];
    array<string> $nearDays = ['gestern', 'heute', 'morgen'];

    return Locale(
        $id: 'de',
        $months: $months,
        $monthsShort: $monthsShort,
        $monthsStandaloneShort: $monthsStandaloneShort,
        $monthsNarrow: $monthsNarrow,
        $weekdays: $weekdays,
        $weekdaysShort: $weekdaysShort,
        $weekdaysNarrow: $weekdaysNarrow,
        $quarters: $quarters,
        $quartersShort: $quartersShort,
        $eras: $eras,
        $erasWide: $erasWide,
        $dayPeriods: $dayPeriods,
        $weekRule: WeekRule::iso(),
        $plural: .one,
        $units: $units,
        $relative: $relative,
        $nearDays: $nearDays,
        $now: 'jetzt',
        $and: 'und',
    );
}
