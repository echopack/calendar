namespace calendar;

/**
 * A fixed distance from UTC, in seconds east.
 *
 * Zurich in winter is `+01:00`, New York in summer `-04:00`. Limited to plus or minus
 * 25:59:59. Interpolated, an offset prints as `+01:00`, with seconds only when it has some.
 */
public struct Offset : contract::comparable<Offset>
{
    /**
     * Seconds east of UTC; negative west of it.
     */
    public const int32 $seconds;

    /**
     * An offset of `$seconds` east of UTC. Past 25:59:59 either way stops the program.
     */
    constructor(int32 $seconds)
    {
        if ($seconds < -93599 || $seconds > 93599) {
            Offset::refuse($seconds);
        }

        $this->seconds = $seconds;
    }

    // kept out of line so the constructor stays small enough to inline
    private static function refuse(int32 $seconds) : void
    {
        die("calendar: an offset of {$seconds} seconds is past 25:59:59");
    }

    /**
     * An offset in hours and minutes. The sign of `$hours` applies to the minutes, so
     * `Offset(hours: -3, $minutes: 30)` is `-03:30`. Past 25:59:59 either way stops the
     * program.
     */
    constructor(hours: int32 $hours, int32 $minutes = 0)
    {
        int32 $total = $hours * 3600 + $minutes * 60;

        if ($hours < 0) {
            $total = $hours * 3600 - $minutes * 60;
        }

        if ($total < -93599 || $total > 93599) {
            die("calendar: an offset of {$hours} hours is past 25:59:59");
        }

        $this->seconds = $total;
    }

    /**
     * Zero, `+00:00`.
     */
    public static function utc() : Offset
    {
        return Offset(0);
    }

    /**
     * Parse `Z`, `+01:00`, `+0100`, `+01`, `+01:00:30` or `+010030`. The hour takes two
     * digits and at most 25; anything after the offset is `ParseError::trailing`.
     */
    public static function parse(const string& $text) : result<Offset, ParseError>
    {
        Scanner $s = Scanner($text);
        Offset $o = guard Offset::scan($s, true) else ($e) {
            return .error($e);
        };

        if (!$s->done()) {
            return .error(.trailing($s->at));
        }

        return .ok($o);
    }

    // +hh[:]mm, then [:]ss when $seconds and they are not zero
    internal const function text(bool $colon, bool $seconds) : string
    {
        int64 $total = $this->seconds as int64;
        string $out = '+';

        if ($total < 0) {
            $out = '-';
            $total = -$total;
        }

        $out->append(pad($total / 3600, 2));

        if ($colon) {
            $out->append(':');
        }

        $out->append(pad(($total / 60) % 60, 2));

        if ($seconds && $total % 60 != 0) {
            if ($colon) {
                $out->append(':');
            }

            $out->append(pad($total % 60, 2));
        }

        return $out;
    }

    // +1, +5:30: the hour unpadded, minutes only when there are some
    internal const function short() : string
    {
        int64 $total = $this->seconds as int64;
        string $out = '+';

        if ($total < 0) {
            $out = '-';
            $total = -$total;
        }

        $out->append(str::from($total / 3600));

        if (($total / 60) % 60 != 0) {
            $out->append(':');
            $out->append(pad(($total / 60) % 60, 2));
        }

        return $out;
    }

    // +hh, +hhmm, +hh:mm or +hh:mm:ss, and +hhmmss when $basicSeconds
    internal static function scan(Scanner& $s, bool $basicSeconds = false) : result<Offset, ParseError>
    {
        if ($s->eat(90) || $s->eat(122)) {
            return .ok(Offset(0));
        }

        int32 $sign = 1;

        if ($s->eat(45)) {
            $sign = -1;
        } else if (!$s->eat(43)) {
            return .error(.expected($s->at, "'Z', '+' or '-'"));
        }

        usize $at = $s->at;
        int64 $hours = guard $s->digits(2, 2) else {
            return .error(.expected($at, 'a two-digit hour'));
        };

        int64 $minutes = 0;
        int64 $seconds = 0;
        bool $colon = $s->eat(58);
        usize $minuteAt = $s->at;
        int64? $m = $s->digits(2, 2);

        if ($m != null) {
            int64 $readMinutes = guard $m;
            $minutes = $readMinutes;

            if ($colon && $s->eat(58)) {
                usize $secondAt = $s->at;
                int64 $readSeconds = guard $s->digits(2, 2) else {
                    return .error(.expected($secondAt, 'two-digit seconds'));
                };
                $seconds = $readSeconds;
            } else if (!$colon && $basicSeconds) {
                // +hhmmss, as the X and x letters write an offset with seconds
                $seconds = $s->digits(2, 2) ?? 0;
            }
        } else if ($colon) {
            return .error(.expected($minuteAt, 'two-digit minutes'));
        }

        if ($hours > 25 || $minutes > 59 || $seconds > 59) {
            return .error(.invalid(.offset, $hours, $at));
        }

        return .ok(Offset((($hours * 3600 + $minutes * 60 + $seconds) * ($sign as int64)) as int32));
    }
}

operator (const Offset& $a) == (const Offset& $b) : bool
{
    return $a->seconds == $b->seconds;
}

operator (const Offset& $a) != (const Offset& $b) : bool
{
    return $a->seconds != $b->seconds;
}

operator (const Offset& $a) < (const Offset& $b) : bool
{
    return $a->seconds < $b->seconds;
}
