namespace calendar;

/**
 * A month of the Gregorian year. The backing value is the month number, 1 to 12.
 */
public enum Month : uint8
{
    case january = 1;
    case february = 2;
    case march = 3;
    case april = 4;
    case may = 5;
    case june = 6;
    case july = 7;
    case august = 8;
    case september = 9;
    case october = 10;
    case november = 11;
    case december = 12;

    /**
     * The month for a number 1 to 12, or null.
     */
    public static function of(int64 $number) : Month?
    {
        if ($number < 1 || $number > 12) {
            return null;
        }

        return Month::from($number as uint8);
    }

    /**
     * The month number as an `int32`, 1 to 12.
     */
    #[inline]
    public const function number() : int32
    {
        return $this->value() as int32;
    }

    /**
     * How many days the month has in `$year`.
     */
    public const function days(int32 $year) : int32
    {
        return Date::monthDays($year as int64, $this->number() as int64) as int32;
    }

    /**
     * The quarter the month falls in, 1 to 4.
     */
    public const function quarter() : int32
    {
        return ($this->number() - 1) / 3 + 1;
    }

    /**
     * The month `$count` months later, wrapping around the year. Negative goes back.
     */
    public const function plus(int64 $count) : Month
    {
        int64 $n = floorMod(($this->number() as int64) - 1 + $count, 12) + 1;
        Month $m = guard Month::from($n as uint8);
        return $m;
    }

    /**
     * The month after this one. December wraps to January.
     */
    public const function next() : Month
    {
        return $this->plus(1);
    }

    /**
     * The month before this one. January wraps to December.
     */
    public const function previous() : Month
    {
        return $this->plus(-1);
    }
}
