namespace calendar;

use std::thread;

/**
 * Zones read from compiled zone files (TZif) in a directory.
 *
 * `SystemZones()` reads the operating system's: `$TZDIR` when it is set and not empty,
 * otherwise `/usr/share/zoneinfo`. The data is as fresh as the system's own updates.
 * `SystemZones(dir)` reads any other directory laid out the same way, such as a copy shipped
 * with the app.
 *
 * Loaded zones are cached per instance behind a lock, so one source can serve every thread.
 * Two threads that load the same zone at once may both read the file; one copy is kept.
 */
#[atomic]
public class SystemZones : ZoneSource
{
    /**
     * The directory zone names are resolved under.
     */
    public const string $dir;
    private thread::mutex<map<string, Zone>> $cache;

    /**
     * Zones from `$dir`, a directory of compiled zone files named by zone id. Nothing is read
     * until the first `load`.
     */
    constructor(string $dir)
    {
        $this->dir = $dir;
        $this->cache = thread::mutex<map<string, Zone>>(map<string, Zone>());
    }

    /**
     * Zones from `$TZDIR` when it is set and not empty, otherwise `/usr/share/zoneinfo`.
     */
    constructor()
    {
        $this->dir = SystemZones::defaultDir();
        $this->cache = thread::mutex<map<string, Zone>>(map<string, Zone>());
    }

    /**
     * The zone named `$id`, from the cache or from `$dir/$id`.
     *
     * The name is checked with `valid` before it touches the filesystem, so `../etc/passwd`
     * is `ZoneError::invalid` and never opened. A missing file is `ZoneError::unknown`, except
     * for `UTC`, which falls back to `Zone::utc()` whenever its file cannot be read.
     */
    public function load(const string& $id) : result<Zone, ZoneError>
    {
        Zone? $cached = $this->cached($id);

        if ($cached != null) {
            Zone $hit = guard $cached;
            return .ok($hit);
        }

        if (!SystemZones::valid($id)) {
            return .error(.invalid($id));
        }

        string $bytes = guard std::io::readfile(std::env::join($this->dir, $id)) else ($e) {
            if ($id == 'UTC') {
                return .ok(Zone::utc());
            }

            if ($e->missing() || $e->not_a_directory()) {
                return .error(.unknown($id));
            }

            return .error(.unreadable($id, $e->message()));
        };

        Zone $zone = guard Tzif::parse($id, $bytes) else ($e) {
            return .error($e);
        };

        thread::locked<map<string, Zone>> $held = $this->cache->lock();
        $held->value->set($id, $zone);
        return .ok($zone);
    }

    // the zone already loaded under $id, read under the lock
    private function cached(const string& $id) : Zone?
    {
        thread::locked<map<string, Zone>> $held = $this->cache->lock();

        if ($held->value->has($id)) {
            return $held->value->get($id);
        }

        return null;
    }

    /**
     * Zone names from the directory's `tzdata.zi` index, links included. Empty when the
     * system ships no index.
     */
    public function ids() : array<string>
    {
        array<string> $out = [];
        std::io::file $f = guard std::io::open(std::env::join($this->dir, 'tzdata.zi'), .read) else {
            return $out;
        };

        foreach ($f as const &$line) {
            if ($line->starts('Z ')) {
                usize $end = $line->find(' ', 2);
                $out[] = string::from($line->sub(2, $end - 2));
            } else if ($line->starts('L ')) {
                usize $space = $line->find(' ', 2);

                if ($space < $line->size()) {
                    $out[] = string::from($line->sub($space + 1, $line->size() - $space - 1));
                }
            }
        }

        return $out;
    }

    /**
     * True for a plausible zone name: relative, no `..` segment, only letters, digits and
     * `/ _ - + .`. Checked before the name ever reaches the filesystem.
     */
    public static function valid(const string& $id) : bool
    {
        usize $n = $id->size();

        if ($n == 0 || $n > 255 || $id->byte(0) == 47 || $id->byte(0) == 46) {
            return false;
        }

        if ($id->contains('..') || $id->contains('//')) {
            return false;
        }

        for ($i = 0; $i < $n; $i++) {
            if (!SystemZones::idByte($id->byte($i))) {
                return false;
            }
        }

        return true;
    }

    // a byte a zone name may hold: letters, digits and / _ - + .
    internal static function idByte(uint8 $c) : bool
    {
        return ($c >= 65 && $c <= 90) || ($c >= 97 && $c <= 122) || ($c >= 48 && $c <= 57)
            || $c == 47 || $c == 95 || $c == 45 || $c == 43 || $c == 46;
    }

    private static function defaultDir() : string
    {
        string::view? $dir = std::env::var('TZDIR');

        if ($dir != null) {
            string::view $v = guard $dir;

            if (!$v->empty()) {
                return string::from($v);
            }
        }

        return '/usr/share/zoneinfo';
    }
}
