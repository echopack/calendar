namespace calendar;

/**
 * The cursor `foreach` uses over a `DateRange` or `DateSteps`. Each date is computed from the
 * start, so clamped month steps never drift.
 */
public struct DateCursor : contract::iterator<Date>, contract::keyed<usize>
{
    private Date $start;
    private Date $end;
    private Period $step;
    private Date $value;
    private int64 $produced;

    /**
     * A cursor before the first date. A step that does not move forward or has hours, minutes
     * or seconds, or an end before the start, stops the program, as `DateSteps` does.
     */
    constructor(Date $start, Date $end, Period $step)
    {
        DateCursor::check($start, $end, $step);

        $this->start = $start;
        $this->end = $end;
        $this->step = $step;
        $this->value = $start;
        $this->produced = 0;
    }

    // a step that never reaches $end, or an end before the start, is a bug in the caller
    internal static function check(const Date& $start, const Date& $end, const Period& $step) : void
    {
        Date::dated($step);

        if ($step->totalMonths() < 0 || $step->totalDays() < 0 || ($step->totalMonths() == 0 && $step->totalDays() == 0)) {
            die('calendar: a date step has to move forward');
        }

        if ($end < $start) {
            die('calendar: date steps cannot end before they start');
        }
    }

    /**
     * Move to the next date. False once it would reach `$end` or leave the supported years.
     */
    public function advance() : bool
    {
        Period $by = $this->step * $this->produced;
        Date $next = guard $this->start->shift($by->totalMonths(), $by->totalDays(), .clamp) else {
            return false;
        };

        if ($next >= $this->end) {
            return false;
        }

        $this->value = $next;
        $this->produced = $this->produced + 1;
        return true;
    }

    /**
     * The date the cursor is on.
     */
    public function current() : Date&
    {
        return &$this->value;
    }

    /**
     * The position, starting at 0.
     */
    public function key() : usize
    {
        return ($this->produced - 1) as usize;
    }
}
