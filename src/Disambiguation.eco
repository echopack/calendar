namespace calendar;

/**
 * What to do with a wall-clock time that a zone skips or repeats.
 *
 * When clocks go forward, 02:30 does not happen. When they go back, 02:30 happens twice.
 */
public enum Disambiguation
{
    /**
     * A repeated time takes the earlier instant; a skipped time moves forward by the length
     * of the gap, so 02:30 becomes 03:30. Nothing fails.
     */
    case compatible;

    /**
     * The earlier instant. A skipped time moves back by the gap: 02:30 becomes 01:30.
     */
    case earlier;

    /**
     * The later instant. A skipped time moves forward like `compatible`.
     */
    case later;

    /**
     * Fail with `DateError::gap` or `DateError::overlap`.
     */
    case reject;
}
