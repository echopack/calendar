namespace calendar;

use std::time;

/**
 * The instants from `$start` up to, not including, `$end`.
 *
 * Half-open on purpose: a day is from its midnight to the next one, and no instant belongs to
 * two adjacent days. There is no "end of day" at 23:59:59.999 to get wrong.
 *
 * ```echo
 * $zurich = Zone(named: 'Europe/Zurich');
 * $start = DateTime(2026, .march, 27, 9, 30)->at($zurich)->instant;
 * $meeting = Interval(from: $start, until: $start + time::duration::hours(2));
 * $sunday = DateTime(2026, .march, 29, 12, 0)->at($zurich)->span(.day)->duration();
 * echo "{$meeting}"; // [2026-03-27T08:30:00Z, 2026-03-27T10:30:00Z)
 * echo "{$sunday}";  // 23h0m0s
 * ```
 *
 * An interval holds instants, not wall clocks, so it prints in UTC. `Zoned::span` gives the
 * interval of a whole day, month or hour in a zone; the Sunday above loses an hour to DST.
 */
#[docs::see: ["DateRange", "Zoned"]]
public struct Interval
{
    /**
     * The first instant inside the interval.
     */
    public const time::timestamp $start;

    /**
     * The first instant after the interval, not part of it.
     */
    public const time::timestamp $end;

    /**
     * The instants from `$start` up to `$end`. Equal ends make an empty interval; an `$end`
     * before `$start` stops the program.
     */
    constructor(from: time::timestamp $start, until: time::timestamp $end)
    {
        if ($end < $start) {
            die('calendar: an interval cannot end before it starts');
        }

        $this->start = $start;
        $this->end = $end;
    }

    /**
     * How long the interval is, `$end - $start`.
     */
    public const function duration() : time::duration
    {
        return $this->end - $this->start;
    }

    /**
     * True when `$start` and `$end` are the same instant, so the interval holds none.
     */
    public const function empty() : bool
    {
        return $this->start == $this->end;
    }

    /**
     * True when `$at` is inside: at or after `$start` and before `$end`.
     */
    public const function has(const time::timestamp& $at) : bool
    {
        return $at >= $this->start && $at < $this->end;
    }

    /**
     * True when the two intervals share at least one instant. An empty interval shares none.
     */
    public const function overlaps(const Interval& $other) : bool
    {
        return $this->start < $other->end && $other->start < $this->end && !$this->empty() && !$other->empty();
    }

    /**
     * The instants both intervals hold, or null when they share none.
     */
    public const function intersect(const Interval& $other) : Interval?
    {
        if (!$this->overlaps($other)) {
            return null;
        }

        time::timestamp $start = $this->start;
        time::timestamp $end = $this->end;

        if ($other->start > $start) {
            $start = $other->start;
        }

        if ($other->end < $end) {
            $end = $other->end;
        }

        return Interval(from: $start, until: $end);
    }
}

operator (const Interval& $a) == (const Interval& $b) : bool
{
    return $a->start == $b->start && $a->end == $b->end;
}

operator (const Interval& $a) != (const Interval& $b) : bool
{
    return !($a == $b);
}
